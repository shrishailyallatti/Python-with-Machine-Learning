print('press 2 for reading file')
print('press 3 for updating file')
print('press 4 for deletingfile')

response=int(input('please tell your response:'))
if response==1:
    createfile()
if response==2:
    readfile()
if response==3:
    updatefile()
if response==4:
    deletefile()
