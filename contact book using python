import json

contact = {}


def addcontact():
    name = input('Enter the name: ')
    number = input('Enter number: ')

    contact[name] = number
    print('Contact added...')


def viewcontact():
    if not contact:
        print('No contacts found.')
        return

    for name, number in contact.items():
        print(f'{name}: {number}')


def savecontact():
    with open('contact.json', 'w') as fs:
        json.dump(contact, fs, indent=4)


def loadcontact():
    global contact

    try:
        with open('contact.json', 'r') as fs:
            contact = json.load(fs)
    except FileNotFoundError:
        contact = {}


def search():
    print('1: Search by name')
    print('2: Search by number')

    s = int(input('Enter your response: '))

    if s == 1:
        name = input('Enter name for search: ')

        if name in contact:
            print(f'Found {name}\'s contact')
            print(f'{name}: {contact[name]}')
        else:
            print('There is no such contact.')

    elif s == 2:
        number = input('Enter contact number for search: ')

        found = False

        for name, num in contact.items():
            if num == number:
                print(f'Found contact: {name}: {num}')
                found = True

        if not found:
            print('There is no such contact.')

    else:
        print('Invalid choice.')


def delete():
    name = input('Enter the name of the contact that you want to delete: ')

    if name in contact:
        contact.pop(name)
        print('Contact deleted...')
    else:
        print('There is no such contact.')


loadcontact()

while True:
    print('----------------------------------------------')
    print('1: Add contact')
    print('2: View contacts')
    print('3: Search contact')
    print('4: Delete contact')
    print('5: Exit')

    try:
        response = int(input('Enter your response: '))
    except ValueError:
        print('Please enter a number from 1 to 5.')
        continue

    if response == 1:
        addcontact()
        savecontact()

    elif response == 2:
        viewcontact()

    elif response == 3:
        search()

    elif response == 4:
        delete()
        savecontact()

    elif response == 5:
        print('Exit from the contact book')
        break

    else:
        print('Invalid choice.')
